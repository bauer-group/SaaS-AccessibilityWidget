{
  "name": "@bauer-group/accessibility-widget-demo",
  "version": "0.1.0",
  "description": "Interaktive Demo + Scanner-Testziel für das BAUER GROUP Accessibility Widget.",
  "license": "MIT",
  "author": "BAUER GROUP <info@bauer-group.com>",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24",
    "pnpm": ">=10"
  },
  "scripts": {
    "predev": "tsx scripts/ensure-widget-built.ts",
    "dev": "vite",
    "prebuild": "pnpm --filter @bauer-group/accessibility-widget build && tsx scripts/copy-widget.ts",
    "build": "pnpm typecheck && vite build",
    "preview": "vite preview --port 4173 --strictPort",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "clean": "rimraf dist .vite public/accessibility-widget"
  },
  "dependencies": {
    "@bauer-group/accessibility-widget": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "rimraf": "^6.0.1",
    "tsx": "^4.19.0",
    "typescript": "^5.8.0",
    "vite": "^7.0.0"
  }
}

{
  "$schema": "https://turbo.build/schema.json",
  "ui": "stream",
  "globalDependencies": ["tsconfig.base.json", ".npmrc"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": [
        "src/**",
        "scripts/**",
        "public/**",
        "index.html",
        "tsconfig.json",
        "tsconfig.*.json",
        "package.json",
        "vite.config.*"
      ],
      "outputs": ["dist/**", "build/**", ".output/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "test": {
      "dependsOn": ["^build"],
      "inputs": ["src/**", "test/**", "tests/**", "vitest.config.*"],
      "outputs": ["coverage/**"]
    },
    "typecheck": {
      "dependsOn": ["^build"],
      "inputs": ["src/**", "tsconfig.json", "tsconfig.*.json"]
    },
    "lint": {
      "inputs": ["src/**", ".eslintrc.*", "eslint.config.*"]
    },
    "clean": {
      "cache": false
    },
    "size": {
      "dependsOn": ["build"],
      "inputs": ["dist/**"]
    },
    "release": {
      "dependsOn": ["build", "test", "lint"]
    }
  }
}

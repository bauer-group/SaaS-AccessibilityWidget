{
  "name": "@bauer-group/bfsg-widget",
  "version": "1.0.0-alpha.1",
  "description": "Lazy-loading Accessibility-Widget nach BFSG/EN 301 549. Loader ~4 KB gzip, Core ~10 KB gzip. Kein Tracking, kein Cookie, kein DOM-/ARIA-Override.",
  "license": "MIT",
  "author": "BAUER GROUP <info@de.bauer-group.com>",
  "repository": {
    "type": "git",
    "url": "https://github.com/bauer-group/SaaS-AccessibilityWidget.git",
    "directory": "packages/widget"
  },
  "homepage": "https://github.com/bauer-group/SaaS-AccessibilityWidget/tree/main/packages/widget",
  "type": "module",
  "main": "./dist/bfsg-widget-loader.min.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/bfsg-widget-loader.min.js"
    },
    "./loader": "./dist/bfsg-widget-loader.min.js",
    "./core": "./dist/bfsg-widget-core.min.js",
    "./styles": "./dist/bfsg-widget.min.css"
  },
  "files": ["dist", "src", "README.md", "LICENSE"],
  "scripts": {
    "build": "tsx scripts/build.ts && tsc -p tsconfig.build.json",
    "dev": "tsx scripts/build.ts --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "echo '(eslint not yet configured)'",
    "size": "tsx scripts/measure-size.ts",
    "clean": "rimraf dist"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "esbuild": "^0.24.0",
    "happy-dom": "^17.0.0",
    "rimraf": "^6.0.1",
    "tsx": "^4.19.0",
    "typescript": "^5.8.0",
    "vitest": "^3.0.0"
  },
  "keywords": [
    "accessibility",
    "a11y",
    "bfsg",
    "wcag",
    "wcag2.2",
    "en301549",
    "eaa",
    "widget",
    "lazy-loading",
    "barrierefreiheit"
  ]
}

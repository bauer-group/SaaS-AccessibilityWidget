{
  "name": "@bauer-group/saas-accessibility-widget",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "BFSG / EN 301 549 / WCAG 2.2 AA Accessibility Widget — lazy-loading, CDN-ready, plus framework integrations (React, Vue, Angular, Svelte, Next.js, Nuxt, Astro, WordPress, TYPO3, Drupal, Shopify, Shopware, Magento).",
  "license": "MIT",
  "author": "BAUER GROUP <info@bauer-group.com>",
  "homepage": "https://github.com/bauer-group/SaaS-AccessibilityWidget",
  "repository": {
    "type": "git",
    "url": "https://github.com/bauer-group/SaaS-AccessibilityWidget.git"
  },
  "bugs": {
    "url": "https://github.com/bauer-group/SaaS-AccessibilityWidget/issues"
  },
  "engines": {
    "node": ">=24",
    "pnpm": ">=10"
  },
  "packageManager": "pnpm@10.0.0",
  "scripts": {
    "build": "turbo run build --filter=./packages/* --filter=./apps/*",
    "dev": "turbo run dev --parallel --filter=./packages/* --filter=./apps/*",
    "test": "turbo run test --filter=./packages/* --filter=./apps/*",
    "typecheck": "turbo run typecheck --filter=./packages/* --filter=./apps/*",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "clean": "turbo run clean && rimraf node_modules",
    "size": "turbo run size",
    "changeset": "changeset",
    "changeset:version": "changeset version",
    "changeset:publish": "changeset publish",
    "release": "pnpm run build && pnpm run test && pnpm run changeset:publish",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md,yml,yaml,css}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,md,yml,yaml,css}\"",
    "widget:build": "pnpm --filter @bauer-group/accessibility-widget build",
    "demo:dev": "pnpm --filter @bauer-group/accessibility-widget build && pnpm --parallel --filter=@bauer-group/accessibility-widget --filter=@bauer-group/accessibility-widget-demo run dev",
    "demo:build": "pnpm --filter @bauer-group/accessibility-widget-demo build",
    "demo:preview": "pnpm --filter @bauer-group/accessibility-widget-demo preview",
    "integrations:build": "turbo run build --filter=./integrations/js/*",
    "integrations:test": "turbo run test --filter=./integrations/js/*",
    "integrations:typecheck": "turbo run typecheck --filter=./integrations/js/*",
    "integrations:dev": "turbo run dev --parallel --filter=./integrations/js/*"
  },
  "devDependencies": {
    "@changesets/cli": "^2.31.0",
    "@eslint/js": "^10.0.1",
    "@types/node": "^25.6.0",
    "eslint": "^10.3.0",
    "globals": "^17.6.0",
    "prettier": "^3.4.2",
    "rimraf": "^6.0.1",
    "turbo": "^2.9.9",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.59.2"
  },
  "prettier": {
    "printWidth": 100,
    "tabWidth": 2,
    "singleQuote": true,
    "trailingComma": "all",
    "semi": true,
    "arrowParens": "always",
    "endOfLine": "lf"
  }
}
